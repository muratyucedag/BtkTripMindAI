@{
    Layout = null;
}


<!DOCTYPE html>

<html class="light" lang="tr">

    @await Component.InvokeAsync("_HeadComponentPartial")

<body class="bg-background font-body-md text-on-surface overflow-hidden h-screen flex">
    <!-- 1. SideNavBar (Left, 15%) -->
    @await Component.InvokeAsync("_SidebarComponentPartial")

   
    

    @await Component.InvokeAsync("_ChatComponentPartial")

    <!-- 3. Info Panel (Right, 45%) -->
    <section class="w-[45%] h-screen overflow-y-auto bg-white p-8 space-y-8 chat-scroll">

        <!-- City Hero -->
        <div class="relative rounded-3xl overflow-hidden h-72 shadow-xl group">

            <div id="cityCoverImage"
                 class="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-110"
                 data-alt="Seyahat destinasyonu şehir görünümü"
                 style="background-image: url('MEVCUT_NICE_GORSELIN')">
            </div>

            <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>

            <div class="absolute bottom-6 left-6 text-white">

                <div class="flex gap-2 mb-2">
                    <span class="px-3 py-1 bg-white/20 backdrop-blur-md rounded-full text-[10px] uppercase font-bold tracking-widest">
                        Deniz
                    </span>

                    <span class="px-3 py-1 bg-white/20 backdrop-blur-md rounded-full text-[10px] uppercase font-bold tracking-widest">
                        Kültür
                    </span>

                    <span class="px-3 py-1 bg-white/20 backdrop-blur-md rounded-full text-[10px] uppercase font-bold tracking-widest">
                        Aile Dostu
                    </span>
                </div>

                <h3 class="font-display-lg leading-none">
                    <span id="detectedCity">
                        Şehir seçilmedi
                    </span>

                    <span id="destinationSeparator"
                          class="hidden">
                        ,
                    </span>

                    <span id="detectedCountry"></span>
                </h3>
            </div>
        </div>

        <div class="grid grid-cols-2 gap-6">

            <!-- Weather Card -->
            <div id="weatherCard"
                 class="bg-secondary-container/30 p-6 rounded-3xl flex flex-col justify-between border border-secondary-fixed/50">

                <div class="flex justify-between items-start">
                    <div>
                        <p class="text-label-md text-on-secondary-container font-bold">
                            Hava Durumu
                        </p>

                        <h4 id="currentTemperature"
                            class="text-display-lg-mobile text-on-secondary-container leading-none">
                            --°C
                        </h4>

                        <p id="currentCondition"
                           class="text-label-md text-on-secondary-container/80">
                            Şehir seçilmedi
                        </p>

                        <p id="feelsLikeTemperature"
                           class="text-[11px] text-on-secondary-container/60 mt-1">
                        </p>
                    </div>

                    <img id="currentWeatherIcon"
                         class="w-16 h-16 object-contain hidden"
                         alt="Hava durumu ikonu" />
                </div>

                <div id="forecastContainer"
                     class="grid grid-cols-3 gap-3 pt-4 border-t border-on-secondary-container/10 mt-4">

                    <div class="text-center">
                        <p class="text-[10px] text-on-secondary-container/60 font-bold">
                            -
                        </p>

                        <div class="h-8 flex items-center justify-center">
                            <span class="material-symbols-outlined text-sm">
                                cloud
                            </span>
                        </div>

                        <p class="text-[12px] font-bold">
                            --°
                        </p>
                    </div>

                    <div class="text-center">
                        <p class="text-[10px] text-on-secondary-container/60 font-bold">
                            -
                        </p>

                        <div class="h-8 flex items-center justify-center">
                            <span class="material-symbols-outlined text-sm">
                                cloud
                            </span>
                        </div>

                        <p class="text-[12px] font-bold">
                            --°
                        </p>
                    </div>

                    <div class="text-center">
                        <p class="text-[10px] text-on-secondary-container/60 font-bold">
                            -
                        </p>

                        <div class="h-8 flex items-center justify-center">
                            <span class="material-symbols-outlined text-sm">
                                cloud
                            </span>
                        </div>

                        <p class="text-[12px] font-bold">
                            --°
                        </p>
                    </div>
                </div>
            </div>
            <!-- Budget Card -->
            <div class="bg-surface-container p-6 rounded-3xl flex flex-col border border-outline-variant/30">
                <p class="text-label-md text-on-surface-variant font-bold mb-4">Tahmini Bütçe</p>
                <div class="space-y-3 flex-1">
                    <div>
                        <div class="flex justify-between text-[12px] mb-1">
                            <span>Otel</span>
                            <span class="font-bold">%55</span>
                        </div>
                        <div class="h-2 w-full bg-surface rounded-full overflow-hidden">
                            <div class="h-full bg-primary w-[55%]"></div>
                        </div>
                    </div>
                    <div>
                        <div class="flex justify-between text-[12px] mb-1">
                            <span>Yemek</span>
                            <span class="font-bold">%30</span>
                        </div>
                        <div class="h-2 w-full bg-surface rounded-full overflow-hidden">
                            <div class="h-full bg-tertiary w-[30%]"></div>
                        </div>
                    </div>
                    <div>
                        <div class="flex justify-between text-[12px] mb-1">
                            <span>Ulaşım</span>
                            <span class="font-bold">%15</span>
                        </div>
                        <div class="h-2 w-full bg-surface rounded-full overflow-hidden">
                            <div class="h-full bg-secondary w-[15%]"></div>
                        </div>
                    </div>
                </div>
                <div class="mt-4 pt-4 border-t border-outline-variant/30">
                    <p class="text-[12px] text-on-surface-variant">Toplam</p>
                    <p class="text-headline-md font-bold text-primary">1.480 EUR</p>
                </div>
            </div>
        </div>
        <!-- Dynamic Route Card -->
        <div id="routeCard"
             class="bg-primary-container/20 p-6 rounded-3xl border border-primary/10">

            <div class="flex items-center gap-3 mb-4">
                <span class="material-symbols-outlined text-primary">
                    route
                </span>

                <h4 id="routeTitle"
                    class="font-headline-md text-on-primary-container">
                    3 Günlük Rota
                </h4>
            </div>

            <div id="routeDaysContainer"
                 class="space-y-6 relative
                before:absolute
                before:left-[11px]
                before:top-2
                before:bottom-2
                before:w-0.5
                before:bg-primary/20">

                <p id="routePlaceholder"
                   class="text-body-md text-on-surface-variant">
                    Henüz bir seyahat rotası oluşturulmadı.
                </p>
            </div>
        </div>
        <!-- Accommodations and Food -->
        <div class="grid grid-cols-2 gap-6 pb-8">
            <!-- Hotels -->
            <div class="space-y-4">

                <div class="flex items-center justify-between">
                    <h5 class="text-label-md font-bold uppercase tracking-widest text-on-surface-variant">
                        Konaklama
                    </h5>

                    <span id="hotelCount"
                          class="text-[11px] text-on-surface-variant">
                        0 sonuç
                    </span>
                </div>

                <div id="hotelsContainer"
                     class="space-y-3">

                    <div id="hotelPlaceholder"
                         class="p-4 bg-surface rounded-2xl border border-outline-variant/20">

                        <p class="text-[12px] text-on-surface-variant">
                            Henüz otel önerisi alınmadı.
                        </p>
                    </div>

                </div>
            </div>
            <!-- Restaurants -->
            <div class="space-y-4">

                <div class="flex items-center justify-between">
                    <h5 class="text-label-md font-bold uppercase tracking-widest text-on-surface-variant">
                        Restoranlar
                    </h5>

                    <span id="restaurantCount"
                          class="text-[11px] text-on-surface-variant">
                        0 sonuç
                    </span>
                </div>

                <div id="restaurantsContainer"
                     class="space-y-3">

                    <div id="restaurantPlaceholder"
                         class="p-4 bg-surface rounded-2xl border border-outline-variant/20">

                        <p class="text-[12px] text-on-surface-variant">
                            Henüz restoran önerisi alınmadı.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- Micro-interaction Script -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const chatContainer = document.querySelector('.chat-scroll');
            // Auto scroll to bottom
            chatContainer.scrollTop = chatContainer.scrollHeight;

            // Simple button interaction
            const chips = document.querySelectorAll('footer button');
            chips.forEach(chip => {
                chip.addEventListener('click', function() {
                    const text = this.innerText;
                    // Mock adding a user message
                    console.log('User clicked: ' + text);
                });
            });
        });
    </script>
</body>
</html>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const chatMessages = document.getElementById("chatMessages");
        const messageInput = document.getElementById("messageInput");
        const sendMessageButton = document.getElementById("sendMessageButton");
        const aiThinking = document.getElementById("aiThinking");
        const thinkingText = document.getElementById("thinkingText");
        const quickPromptButtons = document.querySelectorAll(".quick-prompt");

       const detectedCity = document.getElementById("detectedCity");
       const detectedCountry = document.getElementById("detectedCountry");
       const destinationSeparator = document.getElementById("destinationSeparator");

       const currentTemperature = document.getElementById("currentTemperature");
       const currentCondition = document.getElementById("currentCondition");
       const feelsLikeTemperature = document.getElementById("feelsLikeTemperature");
       const currentWeatherIcon = document.getElementById("currentWeatherIcon");
       const forecastContainer = document.getElementById("forecastContainer");

       const cityCoverImage = document.getElementById("cityCoverImage");
     
       const routeCard = document.getElementById("routeCard");
       const routeTitle = document.getElementById("routeTitle");
       const routeDaysContainer = document.getElementById("routeDaysContainer");

       const restaurantsContainer = document.getElementById("restaurantsContainer");
       const restaurantCount = document.getElementById("restaurantCount");

       const hotelsContainer = document.getElementById("hotelsContainer");
       const hotelCount = document.getElementById("hotelCount");

        function scrollChatToBottom() {
            chatMessages.scrollTop = chatMessages.scrollHeight;
        }

            function updateCityCover(imageUrl) {
        if (!imageUrl || !cityCoverImage) {
            return;
        }

        const temporaryImage = new Image();

        temporaryImage.onload = function () {
            cityCoverImage.style.backgroundImage =
                `url("${imageUrl}")`;
        };

        temporaryImage.onerror = function () {
            console.warn(
                "Şehir kapak görseli yüklenemedi:",
                imageUrl
            );
        };

        temporaryImage.src = imageUrl;
    }

        function createUserMessage(message) {
            const userMessageHtml = `
                <div class="flex gap-4 items-start justify-end self-end max-w-[85%]">
                    <div class="bg-primary-container/40 p-5 rounded-2xl rounded-tr-none border border-primary/10">
                        <p class="text-body-md text-on-primary-container"></p>
                    </div>

                    <div class="w-10 h-10 rounded-full bg-secondary-fixed flex-shrink-0 overflow-hidden">
                        <img class="w-full h-full object-cover"
                             alt="Kullanıcı profil fotoğrafı"
                             src="https://lh3.googleusercontent.com/aida-public/AB6AXuCJ9m_0uCYjopEIK8G1vB_YYt2Unk0rfggH8Z5aCNyHXvyjzmI-XpQRnUUzbBnCyAD_dh1IsIxjA73JSkT9UG44QbDzwMko5A04jLsMefCKVId_ITvvlJS-eTmZNJvG-wkXqO0rAVF3VPpMOV22X2YHpwMK1nE_NFkEIaspYOpRwG1OQLQrNRUHp_7e4-O1bqsIxwTGa5Yj8L6Mape0_bhu9j4gBGOXaj3FmScFwbCC_g5WFJYoHuHgPA" />
                    </div>
                </div>
            `;

            const wrapper = document.createElement("div");
            wrapper.innerHTML = userMessageHtml.trim();

            const messageElement = wrapper.firstElementChild;
            const messageText = messageElement.querySelector("p");

            messageText.textContent = message;

            chatMessages.insertBefore(messageElement, aiThinking);
        }

        function createAgentMessage(message) {
            const agentMessageHtml = `
                <div class="flex gap-4 items-start max-w-[85%]">
                    <div class="w-10 h-10 rounded-full bg-primary flex-shrink-0 flex items-center justify-center text-white">
                        <span class="material-symbols-outlined">
                            smart_toy
                        </span>
                    </div>

                    <div class="bg-white p-5 rounded-2xl rounded-tl-none shadow-sm border border-outline-variant/20">
                        <p class="text-body-md text-on-surface whitespace-pre-line"></p>
                    </div>
                </div>
            `;

            const wrapper = document.createElement("div");
            wrapper.innerHTML = agentMessageHtml.trim();

            const messageElement = wrapper.firstElementChild;
            const messageText = messageElement.querySelector("p");

            messageText.textContent = message;

            chatMessages.insertBefore(messageElement, aiThinking);
        }

            function updateDestination(city, country) {
        const hasCity =
            typeof city === "string" &&
            city.trim() !== "";

        const hasCountry =
            typeof country === "string" &&
            country.trim() !== "";

        if (!hasCity && !hasCountry) {
            return;
        }

        if (hasCity) {
            detectedCity.textContent = city.trim();
        }

        if (hasCountry) {
            detectedCountry.textContent = country.trim();
        }

        if (destinationSeparator) {
            destinationSeparator.classList.toggle(
                "hidden",
                !hasCity || !hasCountry
            );
        }
    }

        function updateWeather(weather) {
        if (!weather) {
            return;
        }

        currentTemperature.textContent =
            `${Math.round(weather.temperature)}°C`;

        currentCondition.textContent =
            weather.condition || "Hava durumu bilgisi bulunamadı";

        feelsLikeTemperature.textContent =
            `Hissedilen: ${Math.round(weather.feelsLike)}°C`;

        if (weather.iconUrl) {
            currentWeatherIcon.src = weather.iconUrl;
            currentWeatherIcon.classList.remove("hidden");
        } else {
            currentWeatherIcon.removeAttribute("src");
            currentWeatherIcon.classList.add("hidden");
        }

        if (!Array.isArray(weather.forecasts)) {
            return;
        }

        forecastContainer.innerHTML = "";

        weather.forecasts.slice(0, 3).forEach(function (forecast) {
            const forecastItem =
                document.createElement("div");

            forecastItem.className = "text-center";

            const dayName =
                forecast.dayName || "-";

            const temperature =
                Math.round(forecast.averageTemperature);

            const minTemperature =
                Math.round(forecast.minTemperature);

            const maxTemperature =
                Math.round(forecast.maxTemperature);

            const iconHtml = forecast.iconUrl
                ? `
                    <img src="${forecast.iconUrl}"
                         alt="${forecast.condition || "Hava durumu"}"
                         class="w-8 h-8 mx-auto object-contain" />
                  `
                : `
                    <span class="material-symbols-outlined text-sm">
                        cloud
                    </span>
                  `;

            forecastItem.innerHTML = `
                <p class="text-[10px] text-on-secondary-container/60 font-bold">
                    ${dayName}
                </p>

                <div class="h-8 flex items-center justify-center">
                    ${iconHtml}
                </div>

                <p class="text-[12px] font-bold">
                    ${temperature}°
                </p>

                <p class="text-[9px] text-on-secondary-container/60">
                    ${minTemperature}° / ${maxTemperature}°
                </p>
            `;

            forecastContainer.appendChild(forecastItem);
        });
    }

        function updateRestaurants(restaurantResult) {
        if (!restaurantResult ||
            !Array.isArray(restaurantResult.restaurants) ||
            restaurantResult.restaurants.length === 0) {

            return;
        }

        restaurantsContainer.innerHTML = "";

        restaurantCount.textContent =
            `${restaurantResult.restaurants.length} sonuç`;

        restaurantResult.restaurants.forEach(function (restaurant) {

            const restaurantCard =
                document.createElement("a");

            restaurantCard.className =
                "flex gap-3 p-3 bg-surface rounded-2xl " +
                "border border-outline-variant/20 " +
                "hover:border-primary/40 hover:shadow-sm " +
                "transition-all";

            if (restaurant.googleMapsUrl) {
                restaurantCard.href =
                    restaurant.googleMapsUrl;

                restaurantCard.target = "_blank";
                restaurantCard.rel = "noopener noreferrer";
            }

            const iconContainer =
                document.createElement("div");

            iconContainer.className =
                "w-12 h-12 rounded-xl bg-primary-container/50 " +
                "flex items-center justify-center shrink-0";

            const icon =
                document.createElement("span");

            icon.className =
                "material-symbols-outlined text-primary";

            icon.textContent =
                "restaurant";

            iconContainer.appendChild(icon);

            const contentContainer =
                document.createElement("div");

            contentContainer.className =
                "flex-1 min-w-0";

            const titleRow =
                document.createElement("div");

            titleRow.className =
                "flex items-start justify-between gap-2";

            const restaurantName =
                document.createElement("p");

            restaurantName.className =
                "font-bold text-body-md text-on-surface truncate";

            restaurantName.textContent =
                restaurant.name || "Restoran";

            const ratingContainer =
                document.createElement("div");

            ratingContainer.className =
                "flex items-center gap-1 shrink-0 text-primary text-[11px] font-bold";

            const starIcon =
                document.createElement("span");

            starIcon.className =
                "material-symbols-outlined text-sm";

            starIcon.style.fontVariationSettings =
                "'FILL' 1";

            starIcon.textContent =
                "star";

            const ratingText =
                document.createElement("span");

            ratingText.textContent =
                restaurant.rating > 0
                    ? restaurant.rating.toFixed(1)
                    : "-";

            ratingContainer.appendChild(starIcon);
            ratingContainer.appendChild(ratingText);

            titleRow.appendChild(restaurantName);
            titleRow.appendChild(ratingContainer);

            const address =
                document.createElement("p");

            address.className =
                "text-[11px] text-on-surface-variant " +
                "line-clamp-2 mt-1";

            address.textContent =
                restaurant.address ||
                "Adres bilgisi bulunamadı";

            const details =
                document.createElement("div");

            details.className =
                "flex flex-wrap items-center gap-2 mt-2 " +
                "text-[10px] text-on-surface-variant";

            const priceBadge =
                document.createElement("span");

            priceBadge.className =
                "px-2 py-1 bg-white rounded-full " +
                "border border-outline-variant/20";

            priceBadge.textContent =
                restaurant.priceLevel ||
                "Fiyat bilgisi yok";

            const reviewBadge =
                document.createElement("span");

            reviewBadge.className =
                "px-2 py-1 bg-white rounded-full " +
                "border border-outline-variant/20";

            reviewBadge.textContent =
                `${restaurant.userRatingCount || 0} değerlendirme`;

            details.appendChild(priceBadge);
            details.appendChild(reviewBadge);

            contentContainer.appendChild(titleRow);
            contentContainer.appendChild(address);
            contentContainer.appendChild(details);

            restaurantCard.appendChild(iconContainer);
            restaurantCard.appendChild(contentContainer);

            restaurantsContainer.appendChild(restaurantCard);
        });
    }


        function updateHotels(hotelResult) {

        if (!hotelResult ||
            !Array.isArray(hotelResult.hotels) ||
            hotelResult.hotels.length === 0) {

            return;
        }

        hotelsContainer.innerHTML = "";

        hotelCount.textContent =
            `${hotelResult.hotels.length} sonuç`;

        hotelResult.hotels.forEach(function (hotel) {

            const hotelCard =
                document.createElement("a");

            hotelCard.className =
                "block bg-white border border-outline-variant/30 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow";

            if (hotel.googleMapsUrl) {
                hotelCard.href = hotel.googleMapsUrl;
                hotelCard.target = "_blank";
                hotelCard.rel = "noopener noreferrer";
            }

            const image =
                document.createElement("div");

            image.className =
                "h-32 bg-cover bg-center";

            image.style.backgroundImage =
                hotel.photoUrl
                    ? `url('${hotel.photoUrl}')`
                    : "linear-gradient(to right,#ececec,#d9d9d9)";

            const content =
                document.createElement("div");

            content.className = "p-4";

            content.innerHTML = `
                <div class="flex justify-between items-start mb-1">

                    <h6 class="font-bold text-on-surface">
                        ${hotel.name}
                    </h6>

                    <div class="flex items-center text-primary text-[12px] font-bold">

                        <span class="material-symbols-outlined text-sm mr-0.5"
                              style="font-variation-settings:'FILL' 1;">
                            star
                        </span>

                        ${hotel.rating > 0 ? hotel.rating.toFixed(1) : "-"}

                    </div>

                </div>

                <p class="text-[12px] text-on-surface-variant mb-2">
                    ${hotel.address}
                </p>

                <p class="text-[11px] text-on-surface-variant">
                    ${hotel.userRatingCount} değerlendirme
                </p>
            `;

            hotelCard.appendChild(image);
            hotelCard.appendChild(content);

            hotelsContainer.appendChild(hotelCard);
        });
    }


        function updateRoute(route) {
        if (!route ||
            !Array.isArray(route.days) ||
            route.days.length === 0) {
            return;
        }

        const dayCount =
            route.dayCount || route.days.length;

        routeTitle.textContent =
            `${dayCount} Günlük Rota`;

        routeDaysContainer.innerHTML = "";

        route.days.forEach(function (day, index) {
            const routeDayElement =
                document.createElement("div");

            routeDayElement.className =
                "flex gap-4 relative";

            const circleElement =
                document.createElement("div");

            circleElement.className =
                index === 0
                    ? "w-6 h-6 bg-primary rounded-full border-4 border-white shadow-sm z-10 flex-shrink-0"
                    : "w-6 h-6 bg-white rounded-full border-4 border-primary/30 shadow-sm z-10 flex-shrink-0";

            const contentElement =
                document.createElement("div");

            const titleElement =
                document.createElement("p");

            titleElement.className =
                index === 0
                    ? "text-label-md font-bold text-primary uppercase"
                    : "text-label-md font-bold text-on-surface-variant uppercase";

            titleElement.textContent =
                `${day.dayNumber}. Gün: ${day.title}`;

            const descriptionElement =
                document.createElement("p");

            descriptionElement.className =
                "text-body-md text-on-surface-variant";

            descriptionElement.textContent =
                day.description;

            contentElement.appendChild(titleElement);
            contentElement.appendChild(descriptionElement);

            routeDayElement.appendChild(circleElement);
            routeDayElement.appendChild(contentElement);

            routeDaysContainer.appendChild(routeDayElement);
        });
    }

        function getThinkingMessage(intent) {
            switch (intent) {
                case "Weather":
                    return "Hava durumu bilgileri kontrol ediliyor...";

                case "Hotel":
                    return "Size uygun oteller araştırılıyor...";

                case "Restaurant":
                    return "Restoran önerileri hazırlanıyor...";

                case "Route":
                    return "Seyahat rotanız oluşturuluyor...";

                case "Currency":
                    return "Döviz bilgileri hesaplanıyor...";

                case "Flight":
                    return "Uçuş seçenekleri araştırılıyor...";

                case "Transportation":
                    return "Ulaşım seçenekleri inceleniyor...";

                case "Attraction":
                    return "Gezilecek yerler hazırlanıyor...";

                case "CityRecommendation":
                    return "Size uygun şehirler analiz ediliyor...";

                default:
                    return "Seyahat talebiniz analiz ediliyor...";
            }
        }

        function showThinking(message = "Seyahat talebiniz analiz ediliyor...") {
            thinkingText.textContent = message;
            aiThinking.classList.remove("hidden");
            scrollChatToBottom();
        }

        function hideThinking() {
            aiThinking.classList.add("hidden");
        }

        function setLoadingState(isLoading) {
            sendMessageButton.disabled = isLoading;
            messageInput.disabled = isLoading;

            if (isLoading) {
                sendMessageButton.classList.add(
                    "opacity-60",
                    "cursor-not-allowed"
                );

                messageInput.classList.add("opacity-70");
            } else {
                sendMessageButton.classList.remove(
                    "opacity-60",
                    "cursor-not-allowed"
                );

                messageInput.classList.remove("opacity-70");
            }
        }

        async function getAgentResponse(userMessage) {
            const response = await fetch("/Dashboard/SendMessage", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({
                    message: userMessage
                })
            });

            let result;

            try {
                result = await response.json();
            } catch {
                throw new Error(
                    "Sunucudan geçerli bir cevap alınamadı."
                );
            }

            if (!response.ok) {
                throw new Error(
                    result.message ||
                    "Sunucu isteği başarısız oldu."
                );
            }

            if (!result.isSuccess) {
                throw new Error(
                    result.message ||
                    "Mesaj işlenirken bir hata oluştu."
                );
            }

            return result;
        }

        async function sendMessage() {
            const message = messageInput.value.trim();

            if (message === "") {
                messageInput.focus();
                return;
            }

            createUserMessage(message);

            messageInput.value = "";

            setLoadingState(true);

            showThinking(
                "Seyahat talebiniz analiz ediliyor..."
            );

            scrollChatToBottom();

            try {
                const agentResult = await getAgentResponse(message);

                updateDestination(agentResult.city,agentResult.country);

                    updateCityCover(agentResult.coverImageUrl);

                    if (agentResult.intent === "Weather" && agentResult.weather) 
                    {
                  updateWeather(agentResult.weather);
                }

                    if (agentResult.intent === "Route" &&
        agentResult.route) {

        updateRoute(agentResult.route);
    }

        if (agentResult.intent === "Restaurant" &&
        agentResult.restaurant) {

        updateRestaurants(
            agentResult.restaurant
        );
    }

        if (agentResult.intent === "Hotel" &&
        agentResult.hotel) {

        updateHotels(
            agentResult.hotel
        );
    }

                /*
                 * Backend cevabı geldikten sonra intent bilgisine
                 * göre thinking metnini kısa süreli değiştiriyoruz.
                 */
                thinkingText.textContent =
                    getThinkingMessage(agentResult.intent);

                console.log("Agent sonucu:", agentResult);
                console.log("Intent:", agentResult.intent);
                console.log("Tool:", agentResult.toolName);
                console.log("Success:", agentResult.isSuccess);
                console.log("Message:", agentResult.message);

                /*
                 * Aracın çalıştığını kullanıcıya kısa süre
                 * göstermek için küçük bir bekleme ekledik.
                 */
                await new Promise(function (resolve) {
                    setTimeout(resolve, 700);
                });

                hideThinking();

                createAgentMessage(agentResult.message);
            } catch (error) {
                hideThinking();

                createAgentMessage(
                    error.message ||
                    "Üzgünüm, mesajınızı işlerken bir hata oluştu."
                );
            } finally {
                setLoadingState(false);

                messageInput.focus();
                scrollChatToBottom();
            }
        }

        sendMessageButton.addEventListener("click", function () {
            sendMessage();
        });

        messageInput.addEventListener("keydown", function (event) {
            if (event.key === "Enter" && !event.shiftKey) {
                event.preventDefault();
                sendMessage();
            }
        });

        quickPromptButtons.forEach(function (button) {
            button.addEventListener("click", function () {
                if (messageInput.disabled) {
                    return;
                }

                messageInput.value = button.textContent.trim();
                messageInput.focus();
            });
        });

        scrollChatToBottom();
        messageInput.focus();
    });
</script>