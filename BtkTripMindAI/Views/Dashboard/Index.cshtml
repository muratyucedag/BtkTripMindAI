<script>
    document.addEventListener("DOMContentLoaded", function () {

        const chatMessages = document.getElementById("chatMessages");
        const messageInput = document.getElementById("messageInput");
        const sendMessageButton = document.getElementById("sendMessageButton");
        const aiThinking = document.getElementById("aiThinking");
        const thinkingText = document.getElementById("thinkingText");
        const quickPromptButtons = document.querySelectorAll(".quick-prompt");

       const detectedCity = document.getElementById("detectedCity");
       const detectedCountry = document.getElementById("detectedCountry");
       const destinationSeparator = document.getElementById("destinationSeparator");

        function scrollChatToBottom() {
            chatMessages.scrollTop = chatMessages.scrollHeight;
        }

        function createUserMessage(message) {
            const userMessageHtml = `
                <div class="flex gap-4 items-start justify-end self-end max-w-[85%]">
                    <div class="bg-primary-container/40 p-5 rounded-2xl rounded-tr-none border border-primary/10">
                        <p class="text-body-md text-on-primary-container"></p>
                    </div>

                    <div class="w-10 h-10 rounded-full bg-secondary-fixed flex-shrink-0 overflow-hidden">
                        <img class="w-full h-full object-cover"
                             alt="Kullanıcı profil fotoğrafı"
                             src="https://lh3.googleusercontent.com/aida-public/AB6AXuCJ9m_0uCYjopEIK8G1vB_YYt2Unk0rfggH8Z5aCNyHXvyjzmI-XpQRnUUzbBnCyAD_dh1IsIxjA73JSkT9UG44QbDzwMko5A04jLsMefCKVId_ITvvlJS-eTmZNJvG-wkXqO0rAVF3VPpMOV22X2YHpwMK1nE_NFkEIaspYOpRwG1OQLQrNRUHp_7e4-O1bqsIxwTGa5Yj8L6Mape0_bhu9j4gBGOXaj3FmScFwbCC_g5WFJYoHuHgPA" />
                    </div>
                </div>
            `;

            const wrapper = document.createElement("div");
            wrapper.innerHTML = userMessageHtml.trim();

            const messageElement = wrapper.firstElementChild;
            const messageText = messageElement.querySelector("p");

            messageText.textContent = message;

            chatMessages.insertBefore(messageElement, aiThinking);
        }

        function createAgentMessage(message) {
            const agentMessageHtml = `
                <div class="flex gap-4 items-start max-w-[85%]">
                    <div class="w-10 h-10 rounded-full bg-primary flex-shrink-0 flex items-center justify-center text-white">
                        <span class="material-symbols-outlined">
                            smart_toy
                        </span>
                    </div>

                    <div class="bg-white p-5 rounded-2xl rounded-tl-none shadow-sm border border-outline-variant/20">
                        <p class="text-body-md text-on-surface whitespace-pre-line"></p>
                    </div>
                </div>
            `;

            const wrapper = document.createElement("div");
            wrapper.innerHTML = agentMessageHtml.trim();

            const messageElement = wrapper.firstElementChild;
            const messageText = messageElement.querySelector("p");

            messageText.textContent = message;

            chatMessages.insertBefore(messageElement, aiThinking);
        }

            function updateDestination(city, country) {
        const hasCity =
            typeof city === "string" &&
            city.trim() !== "";

        const hasCountry =
            typeof country === "string" &&
            country.trim() !== "";

        if (!hasCity && !hasCountry) {
            return;
        }

        if (hasCity) {
            detectedCity.textContent = city.trim();
        }

        if (hasCountry) {
            detectedCountry.textContent = country.trim();
        }

        if (destinationSeparator) {
            destinationSeparator.classList.toggle(
                "hidden",
                !hasCity || !hasCountry
            );
        }
    }

        function getThinkingMessage(intent) {
            switch (intent) {
                case "Weather":
                    return "Hava durumu bilgileri kontrol ediliyor...";

                case "Hotel":
                    return "Size uygun oteller araştırılıyor...";

                case "Restaurant":
                    return "Restoran önerileri hazırlanıyor...";

                case "Route":
                    return "Seyahat rotanız oluşturuluyor...";

                case "Currency":
                    return "Döviz bilgileri hesaplanıyor...";

                case "Flight":
                    return "Uçuş seçenekleri araştırılıyor...";

                case "Transportation":
                    return "Ulaşım seçenekleri inceleniyor...";

                case "Attraction":
                    return "Gezilecek yerler hazırlanıyor...";

                case "CityRecommendation":
                    return "Size uygun şehirler analiz ediliyor...";

                default:
                    return "Seyahat talebiniz analiz ediliyor...";
            }
        }

        function showThinking(message = "Seyahat talebiniz analiz ediliyor...") {
            thinkingText.textContent = message;
            aiThinking.classList.remove("hidden");
            scrollChatToBottom();
        }

        function hideThinking() {
            aiThinking.classList.add("hidden");
        }

        function setLoadingState(isLoading) {
            sendMessageButton.disabled = isLoading;
            messageInput.disabled = isLoading;

            if (isLoading) {
                sendMessageButton.classList.add(
                    "opacity-60",
                    "cursor-not-allowed"
                );

                messageInput.classList.add("opacity-70");
            } else {
                sendMessageButton.classList.remove(
                    "opacity-60",
                    "cursor-not-allowed"
                );

                messageInput.classList.remove("opacity-70");
            }
        }

        async function getAgentResponse(userMessage) {
            const response = await fetch("/Dashboard/SendMessage", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({
                    message: userMessage
                })
            });

            let result;

            try {
                result = await response.json();
            } catch {
                throw new Error(
                    "Sunucudan geçerli bir cevap alınamadı."
                );
            }

            if (!response.ok) {
                throw new Error(
                    result.message ||
                    "Sunucu isteği başarısız oldu."
                );
            }

            if (!result.isSuccess) {
                throw new Error(
                    result.message ||
                    "Mesaj işlenirken bir hata oluştu."
                );
            }

            return result;
        }

        async function sendMessage() {
            const message = messageInput.value.trim();

            if (message === "") {
                messageInput.focus();
                return;
            }

            createUserMessage(message);

            messageInput.value = "";

            setLoadingState(true);

            showThinking(
                "Seyahat talebiniz analiz ediliyor..."
            );

            scrollChatToBottom();

            try {
                const agentResult = await getAgentResponse(message);

                updateDestination(agentResult.city,agentResult.country);

                /*
                 * Backend cevabı geldikten sonra intent bilgisine
                 * göre thinking metnini kısa süreli değiştiriyoruz.
                 */
                thinkingText.textContent =
                    getThinkingMessage(agentResult.intent);

                console.log("Agent sonucu:", agentResult);
                console.log("Intent:", agentResult.intent);
                console.log("Tool:", agentResult.toolName);
                console.log("Success:", agentResult.isSuccess);
                console.log("Message:", agentResult.message);

                /*
                 * Aracın çalıştığını kullanıcıya kısa süre
                 * göstermek için küçük bir bekleme ekledik.
                 */
                await new Promise(function (resolve) {
                    setTimeout(resolve, 700);
                });

                hideThinking();

                createAgentMessage(agentResult.message);
            } catch (error) {
                hideThinking();

                createAgentMessage(
                    error.message ||
                    "Üzgünüm, mesajınızı işlerken bir hata oluştu."
                );
            } finally {
                setLoadingState(false);

                messageInput.focus();
                scrollChatToBottom();
            }
        }

        sendMessageButton.addEventListener("click", function () {
            sendMessage();
        });

        messageInput.addEventListener("keydown", function (event) {
            if (event.key === "Enter" && !event.shiftKey) {
                event.preventDefault();
                sendMessage();
            }
        });

        quickPromptButtons.forEach(function (button) {
            button.addEventListener("click", function () {
                if (messageInput.disabled) {
                    return;
                }

                messageInput.value = button.textContent.trim();
                messageInput.focus();
            });
        });

        scrollChatToBottom();
        messageInput.focus();
    });
</script>