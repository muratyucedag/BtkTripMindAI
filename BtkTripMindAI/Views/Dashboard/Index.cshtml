@{
    Layout = null;
}

<!DOCTYPE html>

<html class="light" lang="tr">

    @await Component.InvokeAsync("_HeadComponentPartial")

<body class="bg-background font-body-md text-on-surface overflow-hidden h-screen flex">
    <!-- 1. SideNavBar (Left, 15%) -->
    @await Component.InvokeAsync("_SidebarComponentPartial")

    @await Component.InvokeAsync("_ChatComponentPartial")

    <!-- 3. Info Panel (Right, 45%) -->
    <section class="w-[45%] h-screen overflow-y-auto bg-white p-8 space-y-8 chat-scroll">

        @await Component.InvokeAsync("_DestinationCityComponentPartial")

        <div class="grid grid-cols-2 gap-6">

            @await Component.InvokeAsync("_WeatherViewComponentPartial")

            @await Component.InvokeAsync("_BudgetViewComponentPartial")
        
        
        </div>
        @await Component.InvokeAsync("_RouteViewComponentPartial")
       
       
        <!-- Accommodations and Food -->
        <div class="grid grid-cols-2 gap-6 pb-8">

            @await Component.InvokeAsync("_HotelViewComponentPartial")

            @await Component.InvokeAsync("_RestaurantViewComponentPartial")
           
          
        </div>
    </section>
    <!-- Micro-interaction Script -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const chatContainer = document.querySelector('.chat-scroll');
            // Auto scroll to bottom
            chatContainer.scrollTop = chatContainer.scrollHeight;

            // Simple button interaction
            const chips = document.querySelectorAll('footer button');
            chips.forEach(chip => {
                chip.addEventListener('click', function() {
                    const text = this.innerText;
                    // Mock adding a user message
                    console.log('User clicked: ' + text);
                });
            });
        });
    </script>

    <script type="module" src="~/js/dashboard/dashboard.js"></script>
</body>
</html>



