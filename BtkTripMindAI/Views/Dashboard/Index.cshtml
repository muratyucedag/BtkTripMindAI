@{
    Layout = null;
}


<!DOCTYPE html>

<html class="light" lang="tr">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>TripMind AI - Akıllı Seyahat Asistanı</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

        .chat-scroll::-webkit-scrollbar {
            width: 4px;
        }

        .chat-scroll::-webkit-scrollbar-track {
            background: transparent;
        }

        .chat-scroll::-webkit-scrollbar-thumb {
            background: #e5e7eb;
            border-radius: 10px;
        }

        .glass-panel {
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(229, 231, 235, 0.5);
        }
    </style>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "surface-tint": "#2e6385",
                        "inverse-primary": "#9accf3",
                        "surface-bright": "#f9f9ff",
                        "on-surface-variant": "#41484d",
                        "surface-container-highest": "#dbe2f9",
                        "on-tertiary-fixed": "#380c03",
                        "secondary-fixed": "#f5e391",
                        "secondary-fixed-dim": "#d8c778",
                        "secondary-container": "#f2e08e",
                        "surface-container-high": "#e0e8ff",
                        "on-surface": "#141b2c",
                        "tertiary-container": "#ffc4b6",
                        "surface-container-low": "#f1f3ff",
                        "on-primary": "#ffffff",
                        "on-error": "#ffffff",
                        "inverse-surface": "#293041",
                        "on-primary-fixed": "#001e2f",
                        "secondary": "#6b5e1a",
                        "on-tertiary-container": "#874939",
                        "on-background": "#141b2c",
                        "surface-container-lowest": "#ffffff",
                        "on-secondary-fixed": "#211b00",
                        "primary-fixed-dim": "#9accf3",
                        "tertiary-fixed": "#ffdad2",
                        "background": "#f9f9ff",
                        "primary-container": "#a5d8ff",
                        "tertiary": "#8c4d3d",
                        "surface": "#f9f9ff",
                        "on-tertiary": "#ffffff",
                        "surface-container": "#e9edff",
                        "on-secondary": "#ffffff",
                        "surface-dim": "#d2daf0",
                        "on-secondary-container": "#70621e",
                        "error": "#ba1a1a",
                        "on-secondary-fixed-variant": "#524601",
                        "outline-variant": "#c1c7ce",
                        "tertiary-fixed-dim": "#ffb4a2",
                        "surface-variant": "#dbe2f9",
                        "primary": "#2e6385",
                        "primary-fixed": "#c9e6ff",
                        "on-tertiary-fixed-variant": "#703628",
                        "on-primary-fixed-variant": "#0c4b6c",
                        "on-primary-container": "#285f80",
                        "inverse-on-surface": "#edf0ff",
                        "error-container": "#ffdad6",
                        "outline": "#71787e",
                        "on-error-container": "#93000a"
                    },
                    "borderRadius": {
                        "DEFAULT": "1rem",
                        "lg": "2rem",
                        "xl": "3rem",
                        "full": "9999px"
                    },
                    "fontFamily": {
                        "body-md": ["Plus Jakarta Sans"],
                        "body-lg": ["Plus Jakarta Sans"],
                        "headline-md": ["Plus Jakarta Sans"],
                        "headline-lg": ["Plus Jakarta Sans"],
                        "label-md": ["Plus Jakarta Sans"],
                        "display-lg": ["Plus Jakarta Sans"]
                    },
                    "fontSize": {
                        "body-md": ["16px", {"lineHeight": "24px", "fontWeight": "400"}],
                        "body-lg": ["18px", {"lineHeight": "28px", "fontWeight": "400"}],
                        "headline-md": ["24px", {"lineHeight": "32px", "fontWeight": "600"}],
                        "headline-lg": ["30px", {"lineHeight": "38px", "fontWeight": "600"}],
                        "label-md": ["14px", {"lineHeight": "20px", "letterSpacing": "0.05em", "fontWeight": "500"}],
                        "display-lg": ["48px", {"lineHeight": "60px", "letterSpacing": "-0.02em", "fontWeight": "700"}]
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-background font-body-md text-on-surface overflow-hidden h-screen flex">
    <!-- 1. SideNavBar (Left, 15%) -->
    <aside class="w-[15%] h-screen sticky top-0 left-0 bg-surface shadow-sm flex flex-col py-8 px-4 border-r border-outline-variant/30 shrink-0">
        <div class="mb-10 px-2 flex items-center gap-3">
            <div class="w-10 h-10 bg-primary-container rounded-xl flex items-center justify-center">
                <span class="material-symbols-outlined text-primary" data-icon="travel_explore">travel_explore</span>
            </div>
            <div>
                <h1 class="text-primary font-headline-md leading-tight tracking-tight">BTK TripMind AI</h1>
                <p class="text-[10px] uppercase tracking-widest text-on-surface-variant font-bold">Seyahat Asistanı</p>
            </div>
        </div>
        <nav class="flex-1 flex flex-col gap-1">
            <a class="flex items-center gap-3 px-4 py-3 bg-primary-container text-on-primary-container rounded-xl font-bold transition-all duration-200" href="#">
                <span class="material-symbols-outlined" data-icon="add_circle">add_circle</span>
                <span class="text-label-md">Yeni Seyahat</span>
            </a>
            <a class="flex items-center gap-3 px-4 py-3 text-on-surface-variant hover:bg-surface-container-high transition-all duration-200" href="#">
                <span class="material-symbols-outlined" data-icon="chat_bubble">chat_bubble</span>
                <span class="text-label-md">Canlı Chat</span>
            </a>
            <a class="flex items-center gap-3 px-4 py-3 text-on-surface-variant hover:bg-surface-container-high transition-all duration-200" href="#">
                <span class="material-symbols-outlined" data-icon="map">map</span>
                <span class="text-label-md">Seyahat Planları</span>
            </a>
            <a class="flex items-center gap-3 px-4 py-3 text-on-surface-variant hover:bg-surface-container-high transition-all duration-200" href="#">
                <span class="material-symbols-outlined" data-icon="favorite">favorite</span>
                <span class="text-label-md">Favorilerim</span>
            </a>
            <a class="flex items-center gap-3 px-4 py-3 text-on-surface-variant hover:bg-surface-container-high transition-all duration-200" href="#">
                <span class="material-symbols-outlined" data-icon="explore">explore</span>
                <span class="text-label-md">Keşfet</span>
            </a>
            <a class="flex items-center gap-3 px-4 py-3 text-on-surface-variant hover:bg-surface-container-high transition-all duration-200" href="#">
                <span class="material-symbols-outlined" data-icon="bookmark">bookmark</span>
                <span class="text-label-md">Kaydedilenler</span>
            </a>
            <a class="flex items-center gap-3 px-4 py-3 text-on-surface-variant hover:bg-surface-container-high transition-all duration-200 mt-auto" href="#">
                <span class="material-symbols-outlined" data-icon="settings">settings</span>
                <span class="text-label-md">Ayarlar</span>
            </a>
        </nav>
        <div class="mt-4 pt-4 border-t border-outline-variant/30">
            <a class="flex items-center gap-3 px-4 py-3 text-on-surface-variant hover:bg-surface-container-high transition-all duration-200 rounded-xl" href="#">
                <div class="w-8 h-8 rounded-full bg-secondary-container overflow-hidden">
                    <img class="w-full h-full object-cover" data-alt="A friendly, high-resolution portrait of a stylish male traveler with a modern haircut, smiling warmly. He is outdoors in a European city during golden hour, wearing a casual linen shirt. The background is softly blurred showing Mediterranean architecture. The style is bright, clean, and optimistic, matching a high-end lifestyle travel app aesthetic." src="https://lh3.googleusercontent.com/aida-public/AB6AXuD4_3NYS4k5DVGR_jwnJvDtdaA-b_sYceEZnZ70_0hOYIrI_dTg2HakEHxuv_dagtWHPv3k91RX2dBW2IBouEgIUteMn3PYffjGsmsGJHjNcupLLD6QeEIGUcb8xBYdJA1d1sKIIgx_jzVdKAb1JKQpNTZBl1rTAuufiLZDen1Q4lANq7Zd_wMzNTcwKFytvQas4x9_2H-NqcPxIANW3PqhkshbtdVyyPw_7a6IheAwp9WVmi_KWhKtyA" />
                </div>
                <span class="text-label-md font-bold">Murat</span>
            </a>
        </div>
    </aside>
    <!-- 2. Chat Section (Center, 40%) -->
    <main class="w-[40%] h-screen flex flex-col bg-surface-container-low/30 border-r border-outline-variant/30">

        <!-- Chat Header -->
        <header class="px-8 py-6 flex items-center justify-between glass-panel sticky top-0 z-10">
            <div class="flex items-center gap-3">
                <div class="w-2.5 h-2.5 bg-green-500 rounded-full animate-pulse"></div>

                <div>
                    <h2 class="font-headline-md text-primary">
                        Seyahat Asistanınız
                    </h2>

                    <p class="text-[11px] text-on-surface-variant">
                        Çevrimiçi
                    </p>
                </div>
            </div>

            <div class="flex gap-2">
                <button type="button"
                        class="p-2 hover:bg-surface-container-high rounded-full transition-colors">
                    <span class="material-symbols-outlined"
                          data-icon="notifications">
                        notifications
                    </span>
                </button>

                <button type="button"
                        class="p-2 hover:bg-surface-container-high rounded-full transition-colors">
                    <span class="material-symbols-outlined"
                          data-icon="help_outline">
                        help_outline
                    </span>
                </button>
            </div>
        </header>

        <!-- Messages Area -->
        <div id="chatMessages"
             class="flex-1 overflow-y-auto px-8 py-6 chat-scroll flex flex-col gap-8">

            <!-- AI Message -->
            <div class="flex gap-4 items-start max-w-[85%]">
                <div class="w-10 h-10 rounded-full bg-primary flex-shrink-0 flex items-center justify-center text-white">
                    <span class="material-symbols-outlined"
                          data-icon="smart_toy">
                        smart_toy
                    </span>
                </div>

                <div class="bg-white p-5 rounded-2xl rounded-tl-none shadow-sm border border-outline-variant/20">
                    <p class="text-body-md text-on-surface">
                        Merhaba Murat! Bugün senin için nasıl bir seyahat planlayalım?
                    </p>
                </div>
            </div>

            <!-- User Message -->
            <div class="flex gap-4 items-start justify-end self-end max-w-[85%]">
                <div class="bg-primary-container/40 p-5 rounded-2xl rounded-tr-none border border-primary/10">
                    <p class="text-body-md text-on-primary-container">
                        Eylül ayında eşim ve çocuğumla 3 günlük Fransa Nice seyahati
                        planlamak istiyorum.
                    </p>
                </div>

                <div class="w-10 h-10 rounded-full bg-secondary-fixed flex-shrink-0 overflow-hidden">
                    <img class="w-full h-full object-cover"
                         alt="Kullanıcı profil fotoğrafı"
                         src="https://lh3.googleusercontent.com/aida-public/AB6AXuCJ9m_0uCYjopEIK8G1vB_YYt2Unk0rfggH8Z5aCNyHXvyjzmI-XpQRnUUzbBnCyAD_dh1IsIxjA73JSkT9UG44QbDzwMko5A04jLsMefCKVId_ITvvlJS-eTmZNJvG-wkXqO0rAVF3VPpMOV22X2YHpwMK1nE_NFkEIaspYOpRwG1OQLQrNRUHp_7e4-O1bqsIxwTGa5Yj8L6Mape0_bhu9j4gBGOXaj3FmScFwbCC_g5WFJYoHuHgPA" />
                </div>
            </div>

            <!-- AI Thinking -->
            <div id="aiThinking"
                 class="hidden flex gap-4 items-start max-w-[85%]">

                <div class="w-10 h-10 rounded-full bg-primary flex-shrink-0 flex items-center justify-center text-white">
                    <span class="material-symbols-outlined"
                          data-icon="smart_toy">
                        smart_toy
                    </span>
                </div>

                <div class="bg-white/80 p-4 rounded-2xl rounded-tl-none flex items-center gap-3">
                    <div class="flex gap-1">
                        <div class="w-2 h-2 bg-primary/40 rounded-full animate-bounce"></div>

                        <div class="w-2 h-2 bg-primary/40 rounded-full animate-bounce [animation-delay:0.2s]"></div>

                        <div class="w-2 h-2 bg-primary/40 rounded-full animate-bounce [animation-delay:0.4s]"></div>
                    </div>

                    <p id="thinkingText"
                       class="text-label-md text-on-surface-variant italic">
                        Asistanınız talebinizi değerlendiriyor...
                    </p>
                </div>
            </div>
        </div>

        <!-- Input Area -->
        <footer class="p-8 space-y-4">

            <!-- Quick Prompts -->
            <div class="flex flex-wrap gap-2">

                <button type="button"
                        class="quick-prompt px-4 py-2 bg-white border border-outline-variant/30 rounded-full text-label-md text-on-surface-variant hover:bg-primary-container hover:text-on-primary-container transition-all">
                    Bir şehir öner
                </button>

                <button type="button"
                        class="quick-prompt px-4 py-2 bg-white border border-outline-variant/30 rounded-full text-label-md text-on-surface-variant hover:bg-primary-container hover:text-on-primary-container transition-all">
                    3 günlük rota oluştur
                </button>

                <button type="button"
                        class="quick-prompt px-4 py-2 bg-white border border-outline-variant/30 rounded-full text-label-md text-on-surface-variant hover:bg-primary-container hover:text-on-primary-container transition-all">
                    Hava durumunu kontrol et
                </button>

                <button type="button"
                        class="quick-prompt px-4 py-2 bg-white border border-outline-variant/30 rounded-full text-label-md text-on-surface-variant hover:bg-primary-container hover:text-on-primary-container transition-all">
                    Otel listele
                </button>

                <button type="button"
                        class="quick-prompt px-4 py-2 bg-white border border-outline-variant/30 rounded-full text-label-md text-on-surface-variant hover:bg-primary-container hover:text-on-primary-container transition-all">
                    Restoran önerileri
                </button>
            </div>

            <!-- Message Input -->
            <div class="relative group">

                <div class="absolute inset-y-0 left-4 flex items-center gap-2 text-outline">

                    <button type="button"
                            class="hover:text-primary transition-colors"
                            title="Dosya ekle">
                        <span class="material-symbols-outlined"
                              data-icon="attach_file">
                            attach_file
                        </span>
                    </button>

                    <button type="button"
                            class="hover:text-primary transition-colors"
                            title="Konum ekle">
                        <span class="material-symbols-outlined"
                              data-icon="location_on">
                            location_on
                        </span>
                    </button>

                    <button type="button"
                            class="hover:text-primary transition-colors"
                            title="Tarih seç">
                        <span class="material-symbols-outlined"
                              data-icon="calendar_month">
                            calendar_month
                        </span>
                    </button>
                </div>

                <input id="messageInput"
                       class="w-full bg-white border-none py-4 pl-32 pr-16 rounded-2xl shadow-lg ring-1 ring-outline-variant/20 focus:ring-2 focus:ring-primary text-body-md transition-all"
                       placeholder="Asistanınıza sorun..."
                       type="text"
                       autocomplete="off" />

                <button id="sendMessageButton"
                        type="button"
                        class="absolute inset-y-2 right-2 px-4 bg-primary text-white rounded-xl flex items-center justify-center hover:bg-surface-tint transition-colors">
                    <span class="material-symbols-outlined"
                          data-icon="send">
                        send
                    </span>
                </button>
            </div>
        </footer>
    </main>
    <!-- 3. Info Panel (Right, 45%) -->
    <section class="w-[45%] h-screen overflow-y-auto bg-white p-8 space-y-8 chat-scroll">

        <!-- City Hero -->
        <div class="relative rounded-3xl overflow-hidden h-72 shadow-xl group">

            <div class="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-110"
                 data-alt="Seyahat destinasyonu şehir görünümü"
                 style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuCau3g5vyEBrNIvclL39NDwwPOx69dMSifFgbtJEvzlPJYI4994a-2lM5F9FoJiMvS9Ey3g_IhdcpfeZyqKhKnwsVqSVTMPKqixHEIZCpeUXRl4CoF2qMJ6JiJPFKPjCP9iszi9cufdUOlSY2UTKN1Wdp_50HnT61Ttv4vs8-oxsbJ3irWpqg2eXHVtfyHlR2N78yBfFg23yDvAc3aIOx_BQGIoLU4GFWvU4v50dUFuj8mVfC99lX6BBQ')">
            </div>

            <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>

            <div class="absolute bottom-6 left-6 text-white">

                <div class="flex gap-2 mb-2">
                    <span class="px-3 py-1 bg-white/20 backdrop-blur-md rounded-full text-[10px] uppercase font-bold tracking-widest">
                        Deniz
                    </span>

                    <span class="px-3 py-1 bg-white/20 backdrop-blur-md rounded-full text-[10px] uppercase font-bold tracking-widest">
                        Kültür
                    </span>

                    <span class="px-3 py-1 bg-white/20 backdrop-blur-md rounded-full text-[10px] uppercase font-bold tracking-widest">
                        Aile Dostu
                    </span>
                </div>

                <h3 class="font-display-lg leading-none">
                    <span id="detectedCity">
                        Şehir seçilmedi
                    </span>

                    <span id="destinationSeparator"
                          class="hidden">
                        ,
                    </span>

                    <span id="detectedCountry"></span>
                </h3>
            </div>
        </div>

        <div class="grid grid-cols-2 gap-6">
            <!-- Weather Card -->
            <div class="bg-secondary-container/30 p-6 rounded-3xl flex flex-col justify-between border border-secondary-fixed/50">
                <div class="flex justify-between items-start">
                    <div>
                        <p class="text-label-md text-on-secondary-container font-bold">Hava Durumu</p>
                        <h4 class="text-display-lg-mobile text-on-secondary-container leading-none">24°C</h4>
                        <p class="text-label-md text-on-secondary-container/80">Güneşli</p>
                    </div>
                    <span class="material-symbols-outlined text-5xl text-yellow-500" data-icon="sunny" style="font-variation-settings: 'FILL' 1;">sunny</span>
                </div>
                <div class="flex justify-between pt-4 border-t border-on-secondary-container/10 mt-4">
                    <div class="text-center">
                        <p class="text-[10px] text-on-secondary-container/60 font-bold">Sal</p>
                        <span class="material-symbols-outlined text-sm" data-icon="partly_cloudy_day">partly_cloudy_day</span>
                        <p class="text-[12px] font-bold">22°</p>
                    </div>
                    <div class="text-center">
                        <p class="text-[10px] text-on-secondary-container/60 font-bold">Çar</p>
                        <span class="material-symbols-outlined text-sm" data-icon="sunny">sunny</span>
                        <p class="text-[12px] font-bold">25°</p>
                    </div>
                    <div class="text-center">
                        <p class="text-[10px] text-on-secondary-container/60 font-bold">Per</p>
                        <span class="material-symbols-outlined text-sm" data-icon="sunny">sunny</span>
                        <p class="text-[12px] font-bold">24°</p>
                    </div>
                </div>
            </div>
            <!-- Budget Card -->
            <div class="bg-surface-container p-6 rounded-3xl flex flex-col border border-outline-variant/30">
                <p class="text-label-md text-on-surface-variant font-bold mb-4">Tahmini Bütçe</p>
                <div class="space-y-3 flex-1">
                    <div>
                        <div class="flex justify-between text-[12px] mb-1">
                            <span>Otel</span>
                            <span class="font-bold">%55</span>
                        </div>
                        <div class="h-2 w-full bg-surface rounded-full overflow-hidden">
                            <div class="h-full bg-primary w-[55%]"></div>
                        </div>
                    </div>
                    <div>
                        <div class="flex justify-between text-[12px] mb-1">
                            <span>Yemek</span>
                            <span class="font-bold">%30</span>
                        </div>
                        <div class="h-2 w-full bg-surface rounded-full overflow-hidden">
                            <div class="h-full bg-tertiary w-[30%]"></div>
                        </div>
                    </div>
                    <div>
                        <div class="flex justify-between text-[12px] mb-1">
                            <span>Ulaşım</span>
                            <span class="font-bold">%15</span>
                        </div>
                        <div class="h-2 w-full bg-surface rounded-full overflow-hidden">
                            <div class="h-full bg-secondary w-[15%]"></div>
                        </div>
                    </div>
                </div>
                <div class="mt-4 pt-4 border-t border-outline-variant/30">
                    <p class="text-[12px] text-on-surface-variant">Toplam</p>
                    <p class="text-headline-md font-bold text-primary">1.480 EUR</p>
                </div>
            </div>
        </div>
        <!-- 3-Day Route Card -->
        <div class="bg-primary-container/20 p-6 rounded-3xl border border-primary/10">
            <div class="flex items-center gap-3 mb-4">
                <span class="material-symbols-outlined text-primary" data-icon="route">route</span>
                <h4 class="font-headline-md text-on-primary-container">3 Günlük Rota</h4>
            </div>
            <div class="space-y-6 relative before:absolute before:left-[11px] before:top-2 before:bottom-2 before:w-0.5 before:bg-primary/20">
                <div class="flex gap-4 relative">
                    <div class="w-6 h-6 bg-primary rounded-full border-4 border-white shadow-sm z-10 flex-shrink-0"></div>
                    <div>
                        <p class="text-label-md font-bold text-primary uppercase">1. Gün: Tarih ve Deniz</p>
                        <p class="text-body-md text-on-surface-variant">Eski Şehir (Vieux Nice) gezisi, Çiçek Pazarı (Cours Saleya), Sahil şeridinde yürüyüş ve akşam yemeği.</p>
                    </div>
                </div>
                <div class="flex gap-4 relative">
                    <div class="w-6 h-6 bg-white rounded-full border-4 border-primary/30 shadow-sm z-10 flex-shrink-0"></div>
                    <div>
                        <p class="text-label-md font-bold text-on-surface-variant uppercase">2. Gün: Sanat ve Manzara</p>
                        <p class="text-body-md text-on-surface-variant">Colline du Château (Kale Tepesi) manzarası, Musee Matisse ziyareti ve Liman bölgesinde keyif.</p>
                    </div>
                </div>
                <div class="flex gap-4 relative">
                    <div class="w-6 h-6 bg-white rounded-full border-4 border-primary/30 shadow-sm z-10 flex-shrink-0"></div>
                    <div>
                        <p class="text-label-md font-bold text-on-surface-variant uppercase">3. Gün: Çevre Gezisi</p>
                        <p class="text-body-md text-on-surface-variant">Eze köyüne yarım günlük gezi veya Saint-Jean-Cap-Ferrat sahil yürüyüş parkuru.</p>
                    </div>
                </div>
            </div>
        </div>
        <!-- Accommodations and Food -->
        <div class="grid grid-cols-2 gap-6 pb-8">
            <!-- Hotel -->
            <div class="space-y-4">
                <h5 class="text-label-md font-bold uppercase tracking-widest text-on-surface-variant">Konaklama</h5>
